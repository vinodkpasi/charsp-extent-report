<?xml version="1.0" encoding="UTF-8"?>
  <configuration>
    <!-- report theme STANDARD/DARK -->
    <!--<theme>DARK</theme> -->
    <!-- document encoding -->
   <encoding>UTF-8</encoding>
    <!-- protocol for script and stylesheets HTTP/HTTPS-->
    <!--<protocol>HTTPS</protocol>-->
    <!-- timeline enabled -->
    <timelineEnabled>true</timelineEnabled>
    <!-- offline report -->
    <enableOfflineMode>false</enableOfflineMode>
    <!-- title of the document -->
    <documentTitle>Test Title</documentTitle>
    <!-- report name - displayed at top-nav -->
    <reportName>Test Report</reportName>
    <!-- timestamp format -->
    <timeStampFormat>MMM dd, yyyy HH:mm:ss</timeStampFormat>
    <!-- custom javascript -->
    <scripts>
      <![CDATA[
        $(document).ready(function() {
        });
      ]]>
    </scripts>
    <!-- custom styles -->
    <styles>
      <![CDATA[
      ]]>
    </styles>
  </configuration>
